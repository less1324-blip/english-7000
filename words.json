# 第二單元 (Unit 2)
4. lieutenant 中尉
5. janitor 清潔工
6. paddle 划槳
    </textarea>
    
    <button class="btn-generate" onclick="generateList()">產生發音列表</button>
    
    <div id="wordList" style="margin-top: 20px;"></div>

    <script>
        // 網頁載入時，自動先產生一次列表（這樣學生打開網頁就不用自己按按鈕了）
        window.onload = function() {
            generateList();
        };

        function generateList() {
            const text = document.getElementById('wordInput').value;
            const lines = text.split('\n');
            const listDiv = document.getElementById('wordList');
            listDiv.innerHTML = '';

            lines.forEach(line => {
                const trimmedLine = line.trim();
                if(trimmedLine === '') return;

                // 【新增功能】如果這行是以 # 開頭，就把它變成單元標題
                if (trimmedLine.startsWith('#')) {
                    const headerDiv = document.createElement('div');
                    headerDiv.className = 'unit-header';
                    // 把 # 拿掉，只顯示後面的文字
                    headerDiv.textContent = trimmedLine.substring(1).trim(); 
                    listDiv.appendChild(headerDiv);
                    return; // 處理完標題就跳過，不當作單字處理
                }

                // 處理單字發音：找尋第一個中文字，並擷取它前面的內容
                let engPart = trimmedLine;
                const chineseMatch = trimmedLine.match(/[\u4e00-\u9fa5]/);
                if (chineseMatch) {
                    engPart = trimmedLine.substring(0, chineseMatch.index);
                }
                // 去除開頭的數字和點 (例如 "1. ")
                engPart = engPart.replace(/^\d+\.\s*/, '').trim();

                if(engPart === '') return;

                const itemDiv = document.createElement('div');
                itemDiv.className = 'word-item';

                const textSpan = document.createElement('span');
                textSpan.className = 'text-part';
                textSpan.textContent = trimmedLine;

                const playBtn = document.createElement('button');
                playBtn.className = 'play-btn';
                playBtn.innerHTML = '🔊 播放';
                playBtn.onclick = () => speak(engPart);

                itemDiv.appendChild(textSpan);
                itemDiv.appendChild(playBtn);
                listDiv.appendChild(itemDiv);
            });
        }

        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US'; 
                utterance.rate = 0.9;     
                window.speechSynthesis.speak(utterance);
            } else {
                alert('你的瀏覽器不支援語音功能，請使用 Google Chrome 或 Safari。');
            }
        }
    </script>
</body>
</html>
